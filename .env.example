# Copy to .env and fill in. Everything here can also be set on the Settings page instead
# (a value saved in Settings takes precedence over the environment).

# Google Shopping search API key: SerpApi (https://serpapi.com) or Serper (https://serper.dev).
SERPAPI_API_KEY=
SERPER_API_KEY=

# SMTP login used to send match emails. For Gmail use your address and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USERNAME=
SMTP_PASSWORD=

# Password-protect the web UI (recommended if it is reachable from outside your home network).
TRACKER_UI_USERNAME=admin
TRACKER_UI_PASSWORD=
