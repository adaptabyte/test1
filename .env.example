# Copy to .env and fill in what you use. Everything here can also be set on the Settings page
# instead (a value saved in Settings takes precedence over the environment).

# Email (Resend): sign up at https://resend.com with the address that should receive alerts,
# then create an API key.
RESEND_API_KEY=

# Optional, free and recommended: eBay Browse API keys from https://developer.ebay.com
# (Production keyset: App ID = client ID, Cert ID = client secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Password-protect the web UI (recommended if it is reachable from outside your home network).
TRACKER_UI_USERNAME=admin
TRACKER_UI_PASSWORD=

# Secret for the bundled SearXNG instance; any long random string.
SEARXNG_SECRET=

# Optional paid Google Shopping sources.
SERPAPI_API_KEY=
SERPER_API_KEY=

# Only if you choose SMTP instead of Resend (Gmail: your address + an App Password).
SMTP_USERNAME=
SMTP_PASSWORD=
